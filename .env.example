NODE_ENV=development
PORT=3000
JWT_SECRET=
DATABASE_PATH=./daybook.db
ADMIN_EMAIL=
APP_URL=http://localhost:3000

# Configure SMTP to deliver password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Daybook <no-reply@example.com>

# Set to the number of trusted proxy hops in front of Node (commonly 1 for Cloudflared or nginx).
TRUST_PROXY_HOPS=1
